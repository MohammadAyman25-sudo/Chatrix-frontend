# Copy to .env.local and adjust as needed.
# When true, the app uses in-browser mock data instead of the REST + Socket.IO API.
VITE_USE_MOCK=false
# When true, the dummy chat simulates replies from other participants.
VITE_MOCK_AUTO_REPLY=true
# Simulates mandatory email verification in mock mode: registering creates an
# unverified account and login returns 403 until the link is redeemed. The mock
# logs the link to the browser console and surfaces it in the UI.
VITE_MOCK_EMAIL_VERIFICATION=false
