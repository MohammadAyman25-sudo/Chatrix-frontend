# Dummy chat for local development — no backend required.
# Set VITE_USE_MOCK=false to talk to the real API at http://localhost:5000.
VITE_USE_MOCK=true
# Set to false to stop simulated replies from other participants.
VITE_MOCK_AUTO_REPLY=true
# Simulates mandatory email verification: register creates an unverified
# account and login returns 403 until verified. The mock prints the link to the
# browser console and shows an "Open verification link" button in the UI.
VITE_MOCK_EMAIL_VERIFICATION=true
