# Real backend (REST + Socket.IO) at http://localhost:5000.
# Set VITE_USE_MOCK=true to use the in-browser dummy chat instead (no backend
# required) — the mock flags below then take effect.
VITE_USE_MOCK=false

# Backend origin for REST, Socket.IO, and `/uploads` media. Defaults to
# http://localhost:5000 when unset.
VITE_API_ORIGIN=http://localhost:5000

# Mock-only settings (ignored while VITE_USE_MOCK=false).
# Set to false to stop simulated replies from other participants.
VITE_MOCK_AUTO_REPLY=true
# Simulates mandatory email verification in mock mode: register creates an
# unverified account and login returns 403 until verified. The mock prints the
# link to the browser console and shows an "Open verification link" button.
VITE_MOCK_EMAIL_VERIFICATION=true
